{
    "name": "ShoppingList Dev Environment",
    "dockerComposeFile": [
        "../_docker/docker-compose.yml",
        "docker-compose.yml"
    ],
    "service": "devcontainer",
    // Wichtig: Nur den DevContainer und die MongoDB aus Docker Hub starten
    "runServices": ["devcontainer", "mongodb"],
    "workspaceFolder": "/workspace",

    // Windows-Bind-Mount liefert keine inotify-Events in den Container.
    // Datei-Watcher muessen daher pollen, sonst kein Hot Reload.
    "containerEnv": {
        "CHOKIDAR_USEPOLLING": "1",
        "CHOKIDAR_INTERVAL": "300"
    },

    "customizations": {
        "vscode": {
        "settings": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "extensions": [
            "dbaeumer.vscode-eslint",
            "esbenp.prettier-vscode",
            "mongodb.mongodb-vscode"
        ]
        }
    },

    "forwardPorts": [3000, 5173, 27017],
    "portsAttributes": {
        "3000": { "label": "API Service" },
        "5173": { "label": "Vite Frontend" },
        "27017": { "label": "MongoDB" }
    },

    "remoteUser": "node"
}