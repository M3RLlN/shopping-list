{
  "name": "ShoppingList Dev Environment",
  "dockerComposeFile": ["../_docker/docker-compose.yml", "docker-compose.yml"],
  "service": "devcontainer",
  // Only start the devcontainer and MongoDB, not the app containers themselves.
  "runServices": ["devcontainer", "mongodb"],
  "workspaceFolder": "/workspace",

  // Windows bind mounts don't deliver inotify events into the container,
  // file watchers have to poll instead, or hot reload breaks.
  "containerEnv": {
    "CHOKIDAR_USEPOLLING": "1",
    "CHOKIDAR_INTERVAL": "300"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mongodb.mongodb-vscode",
        "MaikelPro.git-exclude-pro"
      ]
    }
  },

  "forwardPorts": [3000, 27017],
  "portsAttributes": {
    "3000": { "label": "API Service" },
    "5173": { "label": "Vite Frontend", "onAutoForward": "ignore" },
    "27017": { "label": "MongoDB" }
  },

  "remoteUser": "node"
}
